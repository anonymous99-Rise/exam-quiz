# ============================================================================
# 环境变量示例 —— 复制成 .env.local 后填写
# 生产环境在 Vercel 项目的 Settings → Environment Variables 里配同样的键
# ============================================================================

# ---------- Auth.js（GitHub OAuth，可选）------------------------------------
# 不配这些也能跑：整站退化为「本地模式」，导航里不显示登录入口，进度只存本机。
# 配齐三个键才会开启登录与云同步。
#
# AUTH_SECRET 用 `openssl rand -base64 32` 生成（或任意 32+ 位随机串）
AUTH_SECRET=

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）的 Client ID
AUTH_GITHUB_ID=
# 同一个 App 的 Client secret
AUTH_GITHUB_SECRET=

# 回调地址在 GitHub OAuth App 里填： https://<你的域名>/api/auth/callback/github
# 本地开发另加一条： http://localhost:3000/api/auth/callback/github

# ---------- Supabase（进度云同步，可选）------------------------------------
# 不配则 /api/sync 返回 503，前端隐藏同步状态 —— 与纯本地模式表现一致。
#
# 两个键来自 Supabase 项目 Settings → API：
#   URL        → NEXT_PUBLIC_SUPABASE_URL（或 Vercel 集成注入的 SUPABASE_URL）
#   service_role secret → SUPABASE_SERVICE_ROLE_KEY
#
# ⚠ service_role 会绕过 RLS，**只在服务端使用**，绝不要加 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel 的 Supabase 集成会自动注入 SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY，
# 代码两者都认（见 src/lib/sync/supabase.ts），所以接完集成无需手工填写。
